# SheetMate 配置（复制为 .env 后修改）
# 最少只需要填 DEEPSEEK_API_KEY 一项；也可以启动后在页面「设置」里填写。

# ---- 模型（OpenAI 兼容接口，默认 DeepSeek）----
DEEPSEEK_API_KEY=
# 换成其他兼容服务时填写下面三项（LLM_API_KEY 优先于 DEEPSEEK_API_KEY）
# LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com
# 默认 deepseek-v4-pro，可选 deepseek-flash、deepseek-chat
# LLM_MODEL=deepseek-v4-pro
# LLM_MAX_TOKENS=8192
# LLM_TIMEOUT=120
# Pro / Flash 思考模式默认关闭，可在「设置」页切换；deepseek-chat 不提供思考开关
# 额外参数也可用 {"thinking": {"type": "enabled"}} 开启
# 设置页保存的思考开关优先于额外参数
# LLM_EXTRA_JSON=

# ---- 服务 ----
HOST=127.0.0.1
PORT=8000
# 数据目录（数据库、上传文件、输出文件、工作区），默认 backend/data
# SHEETMATE_DATA_DIR=
MAX_UPLOAD_MB=50

# ---- 账号 ----
# 首次启动自动创建的管理员账号
ADMIN_ACCOUNT=admin
ADMIN_PASSWORD=admin123
# 首次启动是否写入示例客户「顺达物流（示例）」
SEED_DEMO=1

# ---- Agent ----
# ReAct 最多推理几轮
AGENT_MAX_ITERATIONS=12
# 流程某一步出错时，AI 最多自动修复几次
REPAIR_MAX_ATTEMPTS=3
# 生成流程后与人工结果比对不通过时，最多再修正几轮
VERIFY_MAX_ROUNDS=2

# 开发模式下前端地址（跨域白名单）
CORS_ORIGINS=http://localhost:5173
