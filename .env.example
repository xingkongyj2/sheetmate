# SheetMate 运行配置（复制为 .env 后修改）
# 模型 API Key、服务商、接口地址和模型统一在登录后的「设置」页配置。

# ---- 服务 ----
HOST=127.0.0.1
PORT=8000
# 数据目录（数据库、上传文件、输出文件、工作区），默认 backend/data
# SHEETMATE_DATA_DIR=
MAX_UPLOAD_MB=50

# ---- 账号 ----
# 首次启动自动创建的管理员账号
ADMIN_ACCOUNT=admin
ADMIN_PASSWORD=admin123
# 首次启动是否写入示例客户「顺达物流（示例）」
SEED_DEMO=1

# ---- Agent ----
# ReAct 最多推理几轮
AGENT_MAX_ITERATIONS=12
# 流程某一步出错时，AI 最多自动修复几次
REPAIR_MAX_ATTEMPTS=3
# 生成流程后与人工结果比对不通过时，最多再修正几轮
VERIFY_MAX_ROUNDS=2

# 开发模式下前端地址（跨域白名单）
CORS_ORIGINS=http://localhost:5173
