# SheetMate 运行配置（复制为 .env 后修改）
# 模型 API Key、服务商、接口地址和模型统一在登录后的「设置」页配置。

# ---- 服务 ----
# 后端监听的地址；127.0.0.1 只允许本机访问，要让局域网访问改成 0.0.0.0
HOST=127.0.0.1
# 后端监听的端口
PORT=8000
# 数据目录（数据库、上传文件、输出文件、工作区），默认 backend/data
# SHEETMATE_DATA_DIR=
# 单个上传文件的大小上限（MB）
MAX_UPLOAD_MB=50

# ---- 账号 ----
# 首次启动自动创建的管理员账号
ADMIN_ACCOUNT=admin
# 首次启动自动创建的管理员密码；上线前务必改掉
ADMIN_PASSWORD=admin123
# 首次启动是否写入示例客户「顺达物流（示例）」：1 = 写入，0 = 不写入
SEED_DEMO=1

# ---- Agent ----
# ReAct 循环最多推理几轮（每轮 = 一次模型回复 + 它要求的工具调用）
AGENT_MAX_ITERATIONS=1000
# 流程某一步出错时，AI 最多自动修复几次
REPAIR_MAX_ATTEMPTS=30
# 生成流程后与人工结果比对不通过时，最多再修正几轮
VERIFY_MAX_ROUNDS=20

# ---- AI 调用与运行上限 ----
# 下面这些值设置页不再展示，全部在这里调整，修改后重启后端生效。
# 默认值都放得很大，保证长任务能一直跑完，一般不需要改；不写就用行尾 = 后面的默认值。
# 带「0 = …」说明的字段，填 0 有特殊含义。

# --- 单次模型请求 ---
# 单次模型请求的总超时（秒），超过就当作失败并按重试策略处理
# LLM_TIMEOUT_SECONDS=7200
# 单次回复最多输出多少 Token（只限制一次回复，不是整个任务的总量）。
# 0 = 自动：先按 131072 请求，模型支持的上限更小时自动降到它报错里给出的真实上限；填正数则固定使用该值
# LLM_MAX_TOKENS=0
# 回复流连续多久没有新内容就判定断流（秒）
# LLM_STREAM_IDLE_SECONDS=7200
# 模型长时间没有任何响应时，最多等多久后放弃（秒）
# LLM_HARD_IDLE_SECONDS=86400
# 模型多久没有新内容时界面只提示「仍在等待」、不中止任务（秒）；0 = 不提示
# LLM_SOFT_IDLE_SECONDS=90
# 单个工具（读表、跑 SQL、运行脚本等）执行的最长等待（秒）
# TOOL_TIMEOUT_SECONDS=14400
# 点击「停止」后，给模型和工具收尾的宽限时间（秒），超时强制结束
# LLM_CANCELLATION_GRACE_SECONDS=5
# 结构化 JSON 调用（含纠错重试）整体的总时长上限（秒）；0 = 不额外限制，只受单次请求超时约束
# LLM_STRUCTURED_TIMEOUT_SECONDS=0

# --- 重试与纠错 ---
# 回复流中途断开后，自动恢复的最多次数
# LLM_STREAM_RECOVERY_RETRIES=20
# 结构化 JSON 输出格式不对时，让模型重新输出的最多次数；0 = 不纠错
# LLM_STRUCTURED_RETRIES=20
# 工具调用参数不完整或格式不对时，让模型重新发起的最多次数；0 = 不纠错
# LLM_TOOL_PROTOCOL_RETRIES=40
# 连接错误、限流、5xx 时，网络层自动重试的最多次数；0 = 不重试
# LLM_SDK_RETRIES=10

# --- 任务预算（默认关闭 = 不限制单次任务）---
# 是否开启任务预算：0 = 关闭，下面 5 项都不生效；1 = 开启，超过任何一项就保留已有结果并停止任务
# LLM_BUDGET_ENABLED=0
# 开启预算后：单次任务最多调用模型多少次（含核对、重试），0 = 不限
# LLM_MAX_MODEL_CALLS=100000
# 开启预算后：单次任务累计输入 Token 上限，0 = 不限
# LLM_MAX_PROMPT_TOKENS=1000000000
# 开启预算后：单次任务累计总 Token（输入 + 输出）上限，0 = 不限
# LLM_MAX_TOTAL_TOKENS=2000000000
# 开启预算后：单次任务调用模型的总时长上限（秒），0 = 不限
# LLM_MAX_TASK_SECONDS=604800
# 开启预算后：单次请求输入内容的字符数上限（含工具定义），0 = 不限
# LLM_MAX_INPUT_CHARS=100000000

# --- 上下文 ---
# 对话上下文超过多少字符后，自动把较早的执行过程收成简短进度（只整理，不中止任务）；0 = 不按字符触发。
# 调得太大可能超出模型的上下文窗口，模型窗口很大时再调高
# LLM_CONTEXT_TARGET_CHARS=80000
# 模型服务实际的上下文容量（Token），用于给输出和安全余量预留空间；0 = 未知，不据此压缩
# LLM_CONTEXT_WINDOW_TOKENS=0
# 辅助判断（意图识别、核对、计划等）是否也启用模型的深度思考：0 = 关闭（更快更省），1 = 开启
# LLM_AUXILIARY_THINKING=0

# --- 辅助调用的等待时间 ---
# 计划起草 / 计划审查 / 步骤核对 / 完成核对 / 交付核对 / 进度审视 这些辅助调用的单次等待下限（秒）
# AUX_CALL_TIMEOUT_SECONDS=1800
# 自动生成对话标题最多等多久（秒），超时就用默认标题
# TITLE_TIMEOUT_SECONDS=600
# 后台提取长期记忆最多等多久（秒），超时就跳过这一轮
# MEMORY_EXTRACT_TIMEOUT_SECONDS=1800

# --- Agent 循环：补做、修复、换方法 ---
# 计划里某一步核对不通过时，最多补做几次
# MAX_STEP_FIXES=10
# 计划执行完仍有未完成项时，最多修复几轮
# MAX_PLAN_REPAIRS=10
# 模型过早收尾（任务其实没完成）时，最多催促它继续几次
# MAX_COMPLETION_RETRIES=50
# 同一种解决方法最多允许失败几次，之后强制换方法
# METHOD_FAILURE_LIMIT=20
# 一个任务最多尝试几种不同的方法
# MAX_METHODS=30
# 每次运行 Python 脚本后，额外追加的推理轮数（在 AGENT_MAX_ITERATIONS 之外）
# SCRIPT_EXTRA_ITERATIONS=300
# 一次任务里工具调用的总次数上限
# TOOL_CALL_BUDGET=5000
# AI 生成公式失败后，最多重新生成几次
# FORMULA_MAX_ATTEMPTS=10

# ---- Excel 编辑 ----
# OOXML 结构编辑（直接改 xlsx 内部 XML，保留切片器、控件等 openpyxl 会丢失的对象）
# auto（默认）：原件含这类对象且编辑可安全完成时启用；always：能安全完成时一律启用；off：关闭
OOXML_EDIT=auto

# 前端构建产物（npm run build 生成）所在目录，由后端一起托管；默认 frontend/dist
# FRONTEND_DIST=
# 开发模式下前端地址（跨域白名单），多个地址用逗号分隔
CORS_ORIGINS=http://localhost:5173
